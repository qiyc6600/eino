# ============================================================
# Agent Eino Demo 配置文件
# ============================================================
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改下方配置项
#   3. 启动服务：go run ./cmd/server
# ============================================================

# -------------------- 服务器 --------------------
# HTTP 监听地址
ADDR=:8080

# -------------------- 会话 --------------------
# 会话滑动过期时间（如 30m、2h、90s），每次校验成功自动续期
SESSION_TTL=30m
# 会话 Cookie 的 Secure 标记。浏览器只在 HTTPS 或 localhost/127.0.0.1 下保存
# Secure Cookie；用普通 HTTP 在局域网 IP 上演示时设为 false，否则 Cookie 会被
# 静默丢弃、每次请求都显示未认证。
SESSION_COOKIE_SECURE=true

# -------------------- 初始管理员 --------------------
# 当 USER_STORE 中还没有 admin 角色账户时，两项必须同时填写。
# 密码至少 12 个字符。PostgreSQL 已保存管理员后可移除这两个值。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# 登录失败限流：用户名与直接连接 IP 分别计数；5 次失败后锁定 15 分钟
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCKOUT=15m

# -------------------- 存储后端 --------------------
# memory 适合本地演示；file 是单进程 JSON 持久化；postgres 支持多实例共享。
# 多实例部署时将下面所有 *_STORE 设为 postgres，并配置 DATABASE_URL。
USER_STORE=memory
SESSION_STORE=memory
SESSION_STORE_PATH=data/sessions.json
CHECKPOINT_STORE=memory
CHECKPOINT_STORE_PATH=data/checkpoints.json
MEMORY_STORE=memory
MEMORY_STORE_PATH=data/memory.json
THREAD_STORE=memory
THREAD_STORE_PATH=data/threads.json
APPROVAL_STORE=memory
# 示例订单、邮件记录及工具幂等凭据
BUSINESS_STORE=memory

# PostgreSQL（任一 *_STORE=postgres 时必填；服务启动时执行版本化迁移）
DATABASE_URL=
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m

# PostgreSQL 运行事件保留期；到期后接口返回 404，后续写入会清理过期记录
RUN_EVENT_RETENTION=168h

# -------------------- 记忆系统 --------------------
# 每轮注入 system prompt 的记忆 token 预算
MEMORY_BUDGET_TOKENS=400
# 文档片段的 token 预算（与记忆预算独立，0 = 关闭文档检索）
DOCUMENT_BUDGET_TOKENS=800
# 向量召回的相关度下限。0 = 自动：按 embedding 提供方选值。
# 真实 embedding 的相关结果在 0.6-0.9，而 hash 伪嵌入被压缩在 0.15-0.4，
# 用同一个阈值会让 hash 模式下的中文检索失效（实测正确文档只有 0.168）。
VECTOR_MIN_SCORE=0
# 触发 LLM 记忆整合的活跃条目数阈值（演示整合效果可调低，如 3）
MEMORY_CONSOLIDATE_THRESHOLD=30

# -------------------- 模型配置 --------------------
# 模型提供者：mock | openai | ark
# - mock:   内置关键词匹配，无需 API Key，适合开发演示
# - openai: OpenAI 或 OpenAI 兼容 API（DeepSeek/Moonshot/智谱/SiliconFlow/Ollama 等）
# - ark:    字节跳动火山引擎 Ark
MODEL_PROVIDER=mock

# -------------------- OpenAI / OpenAI 兼容 --------------------
# API Key（必填，当 MODEL_PROVIDER=openai 时）
OPENAI_API_KEY=

# 模型名称（必填，当 MODEL_PROVIDER=openai 时）
OPENAI_MODEL=

# Base URL（可选，留空则使用 OpenAI 官方地址）
# 常见兼容 API：
#   DeepSeek:    https://api.deepseek.com
#   Moonshot:    https://api.moonshot.cn/v1
#   智谱 GLM:    https://open.bigmodel.cn/api/paas/v4
#   SiliconFlow: https://api.siliconflow.cn/v1
#   本地 Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# -------------------- Ark（火山引擎）--------------------
# Ark API Key（必填，当 MODEL_PROVIDER=ark 时）
ARK_API_KEY=

# Ark 模型 endpoint ID（必填，当 MODEL_PROVIDER=ark 时）
ARK_MODEL=

# Ark Base URL（可选）
ARK_BASE_URL=

# -------------------- 上下文管理 --------------------
# 上下文窗口 token 上限（进度条满刻度）
MAX_TOKENS=2000
# 送给模型的消息条数上限（0 = 不按条数裁剪）。
# 注意：设得过小会让对话永远达不到摘要阈值，使摘要压缩不再触发。
MAX_MESSAGES=0
# 触发摘要压缩的阈值比例（阈值 = 可用预算 × 此值）
SUMMARIZE_THRESHOLD_RATIO=0.65
# 摘要压缩后的目标 token 数
SUMMARY_TARGET_TOKENS=500
# 为模型回答预留的空间：可用预算 = MAX_TOKENS - RESERVE_OUTPUT_TOKENS - 工具定义开销
RESERVE_OUTPUT_TOKENS=1024
# 单个工具结果的字符上限，超出部分截断，避免一条长结果挤占整个上下文
MAX_TOOL_RESULT_CHARS=8000

# -------------------- 线程历史治理 --------------------
# 两项默认都是"完整保留"：静默丢弃用户对话属于产品决策，不适合作为默认行为。
#
# 单个会话最多保留多少条消息（0 = 不限制）。超出时丢弃最早的消息；
# 注意一旦达到上限，该会话每轮都会重写整块历史（不再走追加路径）。
THREAD_HISTORY_MAX_MESSAGES=0
# 多久未使用的会话会被清理（0 = 永久保留，支持 24h / 720h 这类写法）。
# 清理在写入时顺带执行，且只清理当前用户自己的会话。
THREAD_RETENTION=0
